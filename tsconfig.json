{
    "extends": "@react-native/typescript-config",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        // "node" is for test-support/, which uses the built-in node:sqlite.
        "types": ["jest", "node"]
    },
    "include": ["**/*.ts", "**/*.tsx"],
    // supabase/functions is Deno's, but only partly: the domain, application and
    // scraping code under _shared is plain TypeScript that Jest and Metro also
    // compile, so it stays checked here. Excluded are the two places that touch
    // Deno globals and npm: specifiers — the edge/ adapters and the handlers.
    "exclude": [
        "**/node_modules",
        "**/Pods",
        "supabase/functions/_shared/edge",
        "supabase/functions/*/index.ts"
    ]
}
